{
  "name": "ducksoup",
  "license": "MIT",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "PW_UI=1 playwright test --ui",
    "preview": "vite preview",
    "prepare": "husky",
    "perf": "PERF=1 pnpm build && node scripts/perf/collect-bundle.mjs && pnpm exec lhci autorun && node scripts/perf/collect-lighthouse.mjs && node scripts/perf/compare.mjs",
    "perf:bundle": "PERF=1 pnpm build && node scripts/perf/collect-bundle.mjs && node scripts/perf/compare.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sentry/react": "^10.67.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb": "^8.0.3",
    "immer": "^11.1.16",
    "lucide-react": "^1.17.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.5.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "msw": "^2.14.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6",
    "vite": "^8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
